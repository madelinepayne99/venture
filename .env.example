# Copy this file to .env.local and fill in real values. Never commit .env.local.
# All model calls, database access, and OAuth secrets happen server-side
# only — these names must never be exposed to the browser (no NEXT_PUBLIC_
# prefix on any of them).

# Anthropic API key used server-side by Scout and future agents.
ANTHROPIC_API_KEY=

# Postgres connection string (Neon in production; a local Postgres —
# either your own free Neon dev branch, or a local instance — for
# development). drizzle-kit and the app both read this.
DATABASE_URL=

# Auth.js's session-signing secret. Generate a real one with
# `npx auth secret` or `openssl rand -base64 32` — never reuse the
# obviously-fake value used in tests (see tests/setup.ts).
AUTH_SECRET=

# GitHub OAuth App, restricted at sign-in to the founders' GitHub
# accounts (see lib/auth/allowList.ts — the allow-list is the `founders`
# table itself, not a separate list). Created at
# github.com/settings/developers. Initially one shared GitHub account is
# used for both founders (only one founders.email row is set); Maddie's
# own separate account can be added later with no code change — just set
# her founders row's email once she has her own account. See CLAUDE.md's
# Authentication section for exact setup steps.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Inngest (background job orchestration for Scout's research). Unset in
# local dev — the app then talks to a local Inngest Dev Server
# (`npx inngest-cli@latest dev`) instead of Inngest Cloud, with no
# credentials at all. Only needed for a real deployment.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Founders' approval gate. When true, missions require explicit founder
# approval before Scout (or any future agent) may act. Do not set to false
# in any environment where real research spend or real actions could occur.
REQUIRE_FOUNDER_APPROVAL=true

# Content Bot (Milestone C1) — real media generation providers, registered
# via lib/media/registry.ts. See CLAUDE.md's Content Bot milestone (§0c)
# for the researched vendor choices these values select.
MEDIA_IMAGE_PROVIDER=fal-ai
MEDIA_VOICE_PROVIDER=elevenlabs
MEDIA_EDIT_PROVIDER=shotstack

# fal.ai — real image generation (and, from Milestone C1.5, real video
# generation). Sign up at fal.ai, generate an API key.
FAL_KEY=

# ElevenLabs — real voice generation, with word-level timing data used to
# derive real captions (no separate transcription provider needed). Sign
# up and upgrade to at least the Starter tier for a commercial-use
# license, then generate an API key. ELEVENLABS_MODEL_ID and
# ELEVENLABS_VOICE_ID are optional overrides — left unset, the code picks
# a sensible default model and the account's first available voice.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=
ELEVENLABS_VOICE_ID=

# Shotstack — real hosted video assembly (avoids bundling ffmpeg into a
# serverless function — see CLAUDE.md §0a). Sign up, generate an API key.
# SHOTSTACK_STAGE defaults to "stage" (the sandbox); set to "v1" only once
# the founders decide to render for real, non-test output.
SHOTSTACK_API_KEY=
SHOTSTACK_STAGE=stage

# Where Content Bot's real generated assets are stored. Local disk is
# real, but dev/test only — a real deployment's serverless filesystem
# can't be relied on to persist it (see CLAUDE.md §0b); a real deployment
# needs a real object-store StorageProvider (e.g. Vercel Blob) added
# behind the same lib/storage/registry.ts interface, not built yet.
CONTENT_STORAGE_PROVIDER=local_disk
CONTENT_STORAGE_DIR=

# Which Claude model Content Bot's own planning/safety-review calls use.
# Defaults to the same model Scout uses if left unset.
CONTENT_BOT_MODEL=
