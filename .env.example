# Copy this file to .env.local and fill in real values. Never commit .env.local.
# All model calls, database access, and OAuth secrets happen server-side
# only — these names must never be exposed to the browser (no NEXT_PUBLIC_
# prefix on any of them).

# Anthropic API key used server-side by Scout and future agents.
ANTHROPIC_API_KEY=

# Postgres connection string (Neon in production; a local Postgres —
# either your own free Neon dev branch, or a local instance — for
# development). drizzle-kit and the app both read this.
DATABASE_URL=

# Auth.js's session-signing secret. Generate a real one with
# `npx auth secret` or `openssl rand -base64 32` — never reuse the
# obviously-fake value used in tests (see tests/setup.ts).
AUTH_SECRET=

# GitHub OAuth App, restricted at sign-in to the founders' GitHub
# accounts (see lib/auth/allowList.ts — the allow-list is the `founders`
# table itself, not a separate list). Created at
# github.com/settings/developers. Initially one shared GitHub account is
# used for both founders (only one founders.email row is set); Maddie's
# own separate account can be added later with no code change — just set
# her founders row's email once she has her own account. See CLAUDE.md's
# Authentication section for exact setup steps.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Inngest (background job orchestration for Scout's research). Unset in
# local dev — the app then talks to a local Inngest Dev Server
# (`npx inngest-cli@latest dev`) instead of Inngest Cloud, with no
# credentials at all. Only needed for a real deployment.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Founders' approval gate. When true, missions require explicit founder
# approval before Scout (or any future agent) may act. Do not set to false
# in any environment where real research spend or real actions could occur.
REQUIRE_FOUNDER_APPROVAL=true
